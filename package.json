{
  "name": "ai-projecthub",
  "version": "2.0.0",
  "private": true,
  "description": "Showcase website for AI college projects with WhatsApp ordering and admin panel (React + Tailwind + Framer Motion)",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "build": "vite build",
    "dev": "concurrently -k -n api,web -c blue,magenta \"node --watch server.js\" \"vite\"",
    "reset": "node -e \"require('fs').rmSync('data/projects.json',{force:true});console.log('Projects reset. Restart the server.')\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.500.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0"
  }
}
